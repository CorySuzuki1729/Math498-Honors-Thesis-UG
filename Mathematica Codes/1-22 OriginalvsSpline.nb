Notebook[{
Cell["\<\
Checking Sin[x] plotted against spline; restricted to the interval [Pi/2, Pi]\
\
\>", "Text",
 CellChangeTimes->{{3.883400439764476*^9, 3.8834004736084023`*^9}, {
  3.883401660387601*^9, 
  3.883401673509205*^9}},ExpressionUUID->"2162478a-c9ec-44b1-9377-\
20d84c05208e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"vars", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"16", "-", 
        RowBox[{"4", "*", "Pi"}]}], ")"}], "/", 
      RowBox[{"Pi", "^", "3"}]}], ")"}], ",", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "36"}], "+", 
        RowBox[{"8", "*", "Pi"}]}], ")"}], "/", 
      RowBox[{"Pi", "^", "2"}]}], ")"}], ",", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"24", "+", 
        RowBox[{"5", "*", "Pi"}]}], ")"}], "/", "Pi"}], ")"}], ",", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"-", "4"}], "+", "Pi"}], ")"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.883400564429933*^9, 3.88340063232871*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"d3f067d7-d66f-48d1-b49e-3fce8899d170"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   FractionBox[
    RowBox[{"16", "-", 
     RowBox[{"4", " ", "\[Pi]"}]}], 
    SuperscriptBox["\[Pi]", "3"]], ",", 
   FractionBox[
    RowBox[{
     RowBox[{"-", "36"}], "+", 
     RowBox[{"8", " ", "\[Pi]"}]}], 
    SuperscriptBox["\[Pi]", "2"]], ",", 
   FractionBox[
    RowBox[{"24", "+", 
     RowBox[{"5", " ", "\[Pi]"}]}], "\[Pi]"], ",", 
   RowBox[{
    RowBox[{"-", "4"}], "+", "\[Pi]"}]}], "}"}]], "Output",
 CellChangeTimes->{3.883400700036701*^9},
 CellLabel->"Out[28]=",ExpressionUUID->"a2a85487-927f-444f-b44a-cd54e2a7a76b"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"f", "[", "t_", "]"}], ":=", 
   RowBox[{"Sin", "[", "t", "]"}]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"s", "[", "t_", "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{"vars", "[", 
       RowBox[{"[", "1", "]"}], "]"}], ")"}], "*", 
     RowBox[{"t", "^", "3"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"vars", "[", 
       RowBox[{"[", "2", "]"}], "]"}], ")"}], "*", 
     RowBox[{"t", "^", "2"}]}], "+", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"vars", "[", 
       RowBox[{"[", "3", "]"}], "]"}], ")"}], "*", "t"}], "+", 
    RowBox[{"vars", "[", 
     RowBox[{"[", "4", "]"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], ",", 
     RowBox[{"s", "[", "x", "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"Pi", "/", "2"}], ",", " ", "Pi"}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", "\"\<Expressions\>\""}]}], 
  "]"}]}], "Input",
