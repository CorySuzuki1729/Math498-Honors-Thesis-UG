      RowBox[{
       RowBox[{"yyprime", "[", 
        RowBox[{"k", "-", "1"}], "]"}], "=", 
       RowBox[{"yvalprime", "[", 
        RowBox[{"[", "k", "]"}], "]"}]}], ",", "\n", 
      RowBox[{
       RowBox[{"yydoubprime", "[", 
        RowBox[{"k", "-", "1"}], "]"}], "=", 
       RowBox[{"yvaldoubprime", "[", 
        RowBox[{"[", "k", "]"}], "]"}]}]}], "}"}], ",", "\n", 
    RowBox[{"{", 
     RowBox[{"k", ",", "1", ",", "numparts"}], "}"}]}], "]"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"xx", "[", "k", "]"}], ",", 
      RowBox[{"yy", "[", "k", "]"}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", " ", "0", ",", " ", "n"}], "}"}]}], "]"}], ";"}], "\n", 
 RowBox[{
